# niyoz-core configuration. Copy to .env.development (ENVIRONMENT=development)
# or .env.production and fill in. Every value is blank on purpose.
ENVIRONMENT=development

# Shared secret the web app sends in the X-API-Key header
API_KEY=

# Postgres (same database as the web app, schema in web/src/db/migrations)
DATABASE_URL=

# Redis: message queue + Celery broker
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
PRODUCE_INTERVAL_SECONDS=
CONSUME_INTERVAL_SECONDS=

# Clerk: used to fetch each user's Google OAuth token (YouTube access)
CLERK_SECRET_KEY=

# AI: OpenAI writes the summaries; Gemini is optional
OPENAI_API_KEY=
GEMINI_API_KEY=

# Email delivery (Mailtrap sending API)
MAILTRAP_API_TOKEN=
EMAIL_SUBJECT=
FROM_EMAIL=
FROM_NAME=

# Optional residential proxy for transcript fetching
SCRAPEOPS_API_KEY=

# Optional error tracking
SENTRY_DSN=

# Links and branding inside the email
APP_URL=
CONTACT_EMAIL=
NEWSLETTER_LOGO_URL=

# Demo mode: invented videos + transcripts, no YouTube calls.
# Without OPENAI_API_KEY the summaries are canned too.
YOUTUBE_DEMO_MODE=false
DEMO_THUMB_BASE_URL=
