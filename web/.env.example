# niyoz-web configuration. Copy to .env.local and fill in.
# Every value is blank on purpose.

# Demo mode: run with an invented user and no Clerk/Stripe/Postgres accounts
NEXT_PUBLIC_DEMO_MODE=false

SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_ONBOARDING_VIDEO_URL=

# Emails allowed to see the "send me a newsletter now" button
NEXT_PUBLIC_AUTHORIZED_EMAILS=

# niyoz-core API (core/) and its shared API key
NIYOZ_DEV_API_URL=http://127.0.0.1:8000
NIYOZ_DEV_API_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PROJECT_NAME=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK1=

# Analytics (optional, off when blank)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Clerk (Google sign-in with the YouTube read-only scope)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SIGNING_SECRET=

# Postgres (Neon or local, see src/db/docker-compose.yml)
DATABASE_URL=
